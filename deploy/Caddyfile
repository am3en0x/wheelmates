# The site at the root, the API under api. Caddy gets and renews the certificates itself.
# No www: the domain has no www record, and a site Caddy cannot certify only fills the log.
SITE_HOST {
	encode zstd gzip
	root * /opt/wheelmates/web
	file_server
	header Cache-Control "no-cache"
	header /img/* Cache-Control "public, max-age=86400"
	header /fonts/* Cache-Control "public, max-age=2592000"
}

api.SITE_HOST {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8790
}
